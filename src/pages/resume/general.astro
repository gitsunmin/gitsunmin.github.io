<BaseLayout title="김선민 이력서" description="프론트엔드 개발자 김선민 이력서" noindex={true}>
  <main class="resume-root">
    <div class="resume-toolbar" data-print-hide>
      <button type="button" class="resume-print-btn" onclick="window.print()">
        PDF로 저장 (인쇄)
      </button>
      <span class="resume-toolbar-hint">
        브라우저 인쇄 → 대상을 “PDF로 저장” 선택
      </span>
    </div>

    <article class="resume-paper">
      <!-- 헤더 -->
      <div class="resume-header">
        <div class="resume-id">
          <div class="resume-id-main">
            <h1 class="resume-name">
              {contact.name}<span class="resume-name-en">{contact.nameEn}</span>
            </h1>
            <p class="resume-role">{contact.role}<span class="resume-role-dot">·</span>{contact.totalCareer}</p>
          </div>
          <ul class="resume-contact">
            <li><span class="resume-contact-label">Email</span><a href={`mailto:${contact.email}`}>{contact.email}</a></li>
            <li><span class="resume-contact-label">GitHub</span><a href={contact.github}>github.com/gitsunmin</a></li>
            <li><span class="resume-contact-label">Portfolio</span><a href={contact.portfolio}>gitsunmin.github.io</a></li>
          </ul>
        </div>
        <!-- 소개 -->
        <div class="resume-intro">
          <p class="resume-intro-headline">{intro.headline}</p>
          {intro.body ? <p class="resume-intro-body">{intro.body}</p> : null}
        </div>
      </div>

      <!-- 핵심 역량 -->
      <section class="resume-section">
        <h2>핵심 역량</h2>
        <div class="resume-strengths">
          {strengths.map((s) => (
            <div class="resume-strength">
              <p class="resume-strength-title">{s.title}</p>
              <p class="resume-strength-body">{s.body}</p>
            </div>
          ))}
        </div>
      </section>

      <!-- 경력 -->
      <section class="resume-section">
        <h2>경력</h2>
        <p class="resume-section-note">
          아래 <b>프로젝트명은 포트폴리오 문서로 연결되는 링크</b>입니다.
          각 문서에는 <b>해결한 문제를 케이스 단위로</b> 정리해 두었으며,
          <b>밑줄로 표시된 항목</b>을 누르면 해당 케이스로 바로 이동합니다.
        </p>
        {experiences.map((exp) => (
          <div class="resume-company">
            <div class="resume-company-head">
              <div class="resume-company-title">
                <span class="resume-company-name">{exp.company}</span>
                <span class="resume-company-role">{exp.role}</span>
              </div>
              <span class="resume-company-range">{exp.range}</span>
            </div>
            {exp.summary && <p class="resume-company-summary">{exp.summary}</p>}
            {exp.subProjects.map((proj) => (
              <div class="resume-project">
                <div class="resume-project-head">
                  {proj.link ? (
                    <a class="resume-project-title" href={proj.link}>
                      {proj.name}
                      <svg class="resume-project-link-icon" width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <path d="M7 17 17 7" />
                        <path d="M8 7h9v9" />
                      </svg>
                    </a>
                  ) : (
                    <span class="resume-project-title resume-project-title--plain">{proj.name}</span>
                  )}
                  {proj.range && <span class="resume-project-range">{proj.range}</span>}
                </div>
                {proj.desc && <p class="resume-project-desc">{proj.desc}</p>}
                <ul class="resume-project-points">
                  {proj.points.map((p) =>
                    typeof p === 'string' ? (
                      <li>{p}</li>
                    ) : (
                      <li>
                        <a class="resume-point-link" href={p.link}>{p.lead}</a> — {p.rest}
                      </li>
                    ),
                  )}
                </ul>
                {proj.skills && <p class="resume-project-skills"><b>스킬</b> {proj.skills}</p>}
              </div>
            ))}
          </div>
        ))}
      </section>

      <!-- 공백기간 활동 -->
      <section class="resume-section">
        <h2>공백기간 활동</h2>
        <div class="resume-gap">
          <div class="resume-gap-head">
            <span class="resume-gap-heading">{gapActivity.heading}</span>
            <span class="resume-gap-range">{gapActivity.range}</span>
          </div>
          <p class="resume-gap-desc">{gapActivity.desc}</p>
          <ul class="resume-gap-items">
            {gapActivity.items.map((it) => (
              <li>
                <a class="resume-gap-name" href={it.link}>{it.name}</a>
                <span class="resume-gap-body"> — {it.body}</span>
              </li>
            ))}
          </ul>
        </div>
      </section>

      <!-- 기술 스택 -->
      <section class="resume-section">
        <h2>기술 스택</h2>
        <dl class="resume-skills">
          {skills.map(([label, list]) => (
            <div class="resume-skill-row">
              <dt>{label}</dt>
              <dd>{list}</dd>
            </div>
          ))}
        </dl>
      </section>

      <!-- 학력 · 자격증 -->
      <section class="resume-section resume-two-col">
        <div>
          <h2>학력</h2>
          {education.map((e) => (
            <div class="resume-mini">
              <p class="resume-mini-title">{e.school}</p>
              <p class="resume-mini-sub">{e.range} · {e.detail}</p>
            </div>
          ))}
        </div>
        <div>
          <h2>자격증</h2>
          {certificates.map((c) => (
            <div class="resume-mini">
              <p class="resume-mini-title">{c.name}</p>
              <p class="resume-mini-sub">{c.date} · {c.issuer}</p>
            </div>
          ))}
        </div>
      </section>

      <div class="resume-footer">
        <span>포트폴리오 상세 · </span>
        <a href="https://gitsunmin.github.io/works">gitsunmin.github.io/works</a>
      </div>
    </article>
  </main>
</BaseLayout>

