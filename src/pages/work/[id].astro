---
/**
 * work 상세 — 발표 덱 (/work/<id>)
 *
 * 문서형 뷰를 덱으로 완전히 대체했다. 슬라이드 본문은 rehype-work-sections가
 * MDX에서 만들어 낸 <section data-slide>를 그대로 쓰고, 이 파일은 표지·간지·마무리처럼
 * 문서에는 없고 발표에만 필요한 슬라이드와 그 순서를 더한다.
 *
 * 서브 레포는 탭이 아니라 간지 뒤에 이어지는 장(章)이다. 탭이 사라져서
 * 이력서의 헤딩 딥링크(#슬러그)는 오히려 단순해졌다 — 모든 내용이 한 문서에
 * 펼쳐져 있으므로 탭을 켜 줄 필요 없이 앵커가 바로 그 슬라이드에 닿는다.
 */
import { type GetStaticPaths } from 'astro';
import { type CollectionEntry, getCollection, render } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { DeckController } from '@/components/deck/DeckController';
import { MDXReplacer } from '@/components/MDXReplacer';
import { Works } from '@/data/works';
import '@/components/deck/deck.css';

export const getStaticPaths = (async () => {
  const entries: CollectionEntry<'works'>[] = await getCollection('works', ({ data, id }: CollectionEntry<'works'>) => {
    const cleanId = id.replace(/\.mdx$/, '');
    const isTopLevel = !cleanId.includes('/');
    return isTopLevel && (import.meta.env.PROD ? !data.draft : true);
  });

  return entries.map((entry) => {
    const workId = entry.id.replace(/\.mdx$/, '');
    return { params: { id: workId }, props: { entry, work: Works.find((w) => w.id === workId) } };
  });
}) satisfies GetStaticPaths;

type Props = {
  entry: CollectionEntry<'works'>;
  work: (typeof Works)[number] | undefined;
};

const { entry, work } = Astro.props;
const { id } = Astro.params;
const { Content } = await render(entry);

// 서브 레포는 간지 슬라이드를 앞에 두고 본문을 이어 붙인다.
const allEntries = await getCollection('works');
type Chapter = {
  name: string;
  summary?: string;
  contributions?: string[];
  Content: Awaited<ReturnType<typeof render>>['Content'];
};
const chapters: Chapter[] = [];

for (const repo of work?.subRepos ?? []) {
  const subEntry = allEntries.find((e: CollectionEntry<'works'>) => e.id.replace(/\.mdx$/, '') === `${id}/${repo.slug}`);
  if (!subEntry) continue;
  const { Content: SubContent } = await render(subEntry);
  chapters.push({
    name: repo.name,
    summary: subEntry.data.summary,
    contributions: subEntry.data.contributions,
    Content: SubContent,
  });
}

const title = work?.title ?? entry.data.title;
const description = work?.description.split('\n')[0] ?? entry.data.summary ?? '';
const ogImage = `/og/works/${id}.png`;

const COMPANY_LABELS: Record<string, string> = {
  seonhamlabs: '선함연구소',
  marketboro: '마켓보로',
  korens: '코렌스',
};
const company = work?.careerId ? COMPANY_LABELS[work.careerId] ?? work.careerId : null;

/**
 * 본문이 스스로 기술 스택 절을 갖고 있으면 자동 칩 슬라이드를 만들지 않는다.
 * 두 장이 나란히 서면 읽는 사람은 둘이 어떻게 다른지부터 따지게 되는데,
 * 레이어별로 갈라 적은 본문 표가 언제나 칩 나열보다 많은 것을 말해 준다.
 */
const hasOwnTechSection = /^##\s.*기술/m.test(entry.body ?? '');

/**
 * 프론트매터 한 줄짜리 글에서 `**굵게**`만 살린다.
 * 본문은 MDX가 처리하지만 caveat 같은 프론트매터 값은 그냥 문자열이라, 강조가
 * 별표 그대로 찍힌다. 먼저 이스케이프해서 태그 주입을 막고 나서 강조만 되살린다.
 */
const escapeHtml = (text: string) =>
  text.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
const withStrong = (text: string) =>
  escapeHtml(text).replace(/\*\*(.+?)\*\*/g, '<strong>$1</strong>');

/** `머리말 — 덧말`을 두 덩이로 가른다. 덧말이 없으면 머리말만 돌려준다. */
const splitLead = (text: string): [string, string | null] => {
  const at = text.indexOf(' — ');
  return at === -1 ? [text, null] : [text.slice(0, at), text.slice(at + 3)];
};

/** 본문 슬라이드에 입히는 prose. 크기 조정은 deck.css가 덮어쓴다. */
const PROSE = 'deck-prose prose prose-sm dark:prose-invert max-w-none prose-headings:text-primary prose-headings:font-semibold prose-headings:tracking-tight prose-p:text-muted-foreground prose-p:leading-[1.85] prose-li:text-muted-foreground prose-li:leading-relaxed prose-table:text-sm prose-code:text-[0.8125em] prose-code:font-medium';
---

<BaseLayout title={`${title} - Gitsunmin`} description={description} ogImage={ogImage} ogType="article">
  <div data-deck class="deck">
    {/* ── 표지 ─────────────────────────────────────────────── */}
    <section data-slide="cover" data-slide-title="표지">
      <div class="text-center">
        {work?.icon && (
          <img
            src={work.icon}
            alt={`${title} 아이콘`}
            class="mx-auto size-20 rounded-2xl bg-white p-2 border border-border/40"
          />
        )}
        <h1 class="deck-title mt-8">{title}</h1>
        {work?.range && <p class="deck-lead mt-6">{work.range}</p>}

        {/* 출시 이력은 고지가 아니라 성취라서 표지의 기간 줄 아래에 둔다. */}
        {entry.data.release && (() => {
          const [headline, note] = splitLead(entry.data.release);
          return (
            <div class="deck-release mt-6">
              <p class="deck-release-headline">{headline}</p>
              {note && <p class="deck-release-note">{note}</p>}
            </div>
          );
        })()}

        <div class="mt-10 text-sm text-muted-foreground">
          <p class="font-medium text-foreground">김선민</p>
          {company && <p class="mt-1">{company}</p>}
        </div>
      </div>
    </section>

    {/* ── 소개 ─────────────────────────────────────────────── */}
    <section data-slide="intro" data-slide-title="소개">
      <div>
        <p class="deck-eyebrow">소개</p>

        {/* 본문 전체를 읽는 방식을 바꾸는 단서. 소개보다 먼저 눈에 들어와야 한다. */}
        {entry.data.caveat && (
          <p class="deck-caveat mt-4" set:html={withStrong(entry.data.caveat)} />
        )}

        <p class="deck-lead mt-4 whitespace-pre-line">{work?.description ?? description}</p>

        {entry.data.contributions?.length ? (
          <ul class="mt-8 flex flex-col gap-2 list-none pl-0 text-sm text-muted-foreground">
            {entry.data.contributions.map((item: string) => (
              <li class="pl-4 border-l-2 border-border">{item}</li>
            ))}
          </ul>
        ) : null}

        {work?.links.length ? (
          <div class="mt-8 flex flex-wrap gap-2">
            {work.links.map(({ label, url }) => (
              <a href={url} target="_blank" rel="noopener noreferrer" class="deck-link">{label} ↗</a>
            ))}
          </div>
        ) : null}

        {/* 고지는 한 장을 통째로 쓸 만한 내용이 아니라 소개의 각주로 붙인다. */}
        {entry.data.disclaimer && (
          <p class="deck-note mt-10">
            <strong>고지</strong> — {entry.data.disclaimer}
          </p>
        )}
      </div>
    </section>

    {/* ── 기술 스택 ────────────────────────────────────────── */}
    {work?.techs.length && !hasOwnTechSection ? (
      <section data-slide="techs" data-slide-title="사용 기술">
        <div>
          <p class="deck-eyebrow">사용 기술</p>
          <div class="mt-6 flex flex-wrap gap-2">
            {work.techs.map((tech) => (
              <span class="px-3 py-1 rounded-full text-sm font-medium bg-muted/60 text-muted-foreground border border-border/40">
                {tech}
              </span>
            ))}
          </div>
        </div>
      </section>
    ) : null}

    {/* ── 본문 (rehype가 만든 슬라이드들) ──────────────────── */}
    <div class={PROSE}>
      <Content components={MDXReplacer({})} />
    </div>

    {/* ── 서브 레포 = 장(章) ───────────────────────────────── */}
    {chapters.map((chapter) => (
      <>
        <section data-slide={`chapter-${chapter.name}`} data-slide-title={chapter.name}>
          <div class="text-center">
            <p class="deck-eyebrow">Chapter</p>
            <p class="deck-chapter mt-4">{chapter.name}</p>
            {chapter.summary && <p class="deck-lead mt-6 text-left">{chapter.summary}</p>}
            {chapter.contributions?.length ? (
              <ul class="mt-6 flex flex-col gap-2 list-none pl-0 text-sm text-muted-foreground text-left">
                {chapter.contributions.map((item: string) => (
                  <li class="pl-4 border-l-2 border-border">{item}</li>
                ))}
              </ul>
            ) : null}
          </div>
        </section>
        <div class={PROSE}>
          <chapter.Content components={MDXReplacer({})} />
        </div>
      </>
    ))}

    {/* ── 마무리 ───────────────────────────────────────────── */}
    <section data-slide="thanks" data-slide-title="Q&amp;A">
      <div class="text-center">
        <h2 class="deck-title">감사합니다</h2>
        <p class="deck-lead mt-6">궁금한 점은 언제든 편하게 물어봐 주세요.</p>
        <a href="mailto:tjsals116@gmail.com" class="deck-link mt-10 inline-flex text-base">tjsals116@gmail.com</a>
        <p class="mt-10 text-sm text-muted-foreground">
          <a href="/works" class="underline underline-offset-4">← Works 목록으로</a>
        </p>
      </div>
    </section>
  </div>

  <DeckController client:load autoplayMs={9000} />
</BaseLayout>
