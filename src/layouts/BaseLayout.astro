---
import { ClientRouter } from 'astro:transitions';
import { Providers } from '@/components/Providers';
import { LivingBackground } from '@/components/LivingBackground';
import '@/globals.css';

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  ogType?: 'website' | 'article';
  canonicalURL?: string;
  jsonLd?: string;
  preloadImage?: string;
  noindex?: boolean;
}

const {
  title = 'Gitsunmin',
  description = "Gitsunmin's website | 김선민의 웹사이트",
  ogImage = '/assets/default-og-omage.webp',
  ogType = 'website',
  canonicalURL = Astro.url.href,
  jsonLd,
  preloadImage,
  noindex = false,
} = Astro.props;

const siteURL = 'https://gitsunmin.github.io';
const ogImageURL = ogImage.startsWith('http') ? ogImage : `${siteURL}${ogImage}`;
const pageTitle = title === 'Gitsunmin' ? title : `${title} | Gitsunmin`;
---

<!doctype html>
<html lang="ko">
  <head>
    <script is:inline>
      (function () {
        try {
          var saved = localStorage.getItem('darkMode');
          var prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
          if (saved === 'true' || (saved === null && prefersDark)) {
            document.documentElement.classList.add('dark');
          }
        } catch (e) {}

        // 글자 크기도 첫 페인트 전에 확정한다. useFontSize가 하이드레이션 뒤에
        // 붙이도록 두면, 글이 기본 크기로 한 번 그려졌다가 저장된 배율로
        // 줄었다 커진다 — 읽는 사람에게는 글자 크기가 저 혼자 바뀌는 것으로 보인다.
        try {
          var size = localStorage.getItem('fontSize');
          if (size !== 'small' && size !== 'medium' && size !== 'large') size = 'medium';
          document.documentElement.classList.add('text-' + size);
          document.documentElement.style.setProperty(
            '--font-size-scale',
            size === 'small' ? '0.875' : size === 'large' ? '1.125' : '1',
          );
        } catch (e) {}
      })();
    </script>
    <script is:inline>
      document.addEventListener('astro:before-swap', function (e) {
        var from = document.documentElement;
        var to = e.newDocument.documentElement;

        if (from.classList.contains('dark')) {
          to.classList.add('dark');
        } else {
          to.classList.remove('dark');
        }

        // 글자 크기도 새 문서로 넘긴다. 넘기지 않으면 페이지를 옮길 때마다
        // 기본 크기로 한 번 돌아갔다가 다시 줄어든다.
        to.classList.remove('text-small', 'text-medium', 'text-large');
        ['text-small', 'text-medium', 'text-large'].forEach(function (name) {
          if (from.classList.contains(name)) to.classList.add(name);
        });
        to.style.setProperty(
          '--font-size-scale',
          from.style.getPropertyValue('--font-size-scale') || '1',
        );
      });
    </script>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, nofollow, noimageindex, noarchive" />}
    <title>{pageTitle}</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={canonicalURL} />
    <link rel="alternate" type="application/rss+xml" title="gitsunmin 블로그 RSS" href="/rss.xml" />

    <!-- Open Graph -->
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={ogImageURL} />
    <meta property="og:site_name" content="Gitsunmin" />
    <meta property="og:locale" content="ko_KR" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageURL} />

    <!-- JSON-LD Structured Data -->
    {jsonLd && <script is:inline type="application/ld+json" set:html={jsonLd} />}

    <!-- LCP 이미지 preload: 히어로 이미지를 조기에 fetch하여 LCP 개선 -->
    {preloadImage && <link rel="preload" as="image" href={preloadImage} fetchpriority="high" />}

    <!-- Google tag (gtag.js): defer로 HTML 파싱 완료 후 실행 -->
    <script is:inline defer src="https://www.googletagmanager.com/gtag/js?id=G-CHCGLXSCJN"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());

      gtag('config', 'G-CHCGLXSCJN');
    </script>
    <ClientRouter />
  </head>
  <body>
    <LivingBackground client:load />
    <Providers client:load>
      <slot />
    </Providers>
  </body>
</html>

<style is:global>
  :root {
    color-scheme: light dark;
  }
</style>
