---
// works 문서 상단 브리프.
//
// 공고가 요구하는 "프로젝트 개요 / 본인이 기여한 역할"을 본문 산문에서 분리해,
// 모든 탭 최상단에 같은 형태로 고정 노출한다. 본문은 이슈·해결에 집중시킨다.
//
// 상자로 감싸지 않는다 — 위쪽에 이미 헤더 카드와 탭바가 있어서, 여기서 또
// 테두리를 두르면 본문 시작 전에 상자가 세 겹이 된다.
//
// 값은 각 MDX의 프론트매터(summary / contributions)에서 온다. 전부 optional이라,
// 채우지 않은 문서에서는 아무것도 렌더하지 않는다.

type Props = {
  summary?: string;
  contributions?: string[];
  /** 본문에 `## 문제 N.` 케이스가 있는지. 없으면 케이스 안내를 그리지 않는다. */
  hasCases?: boolean;
};

const { summary, contributions, hasCases = false } = Astro.props;

const hasContributions = Boolean(contributions?.length);
const hasAnything = Boolean(summary) || hasContributions || hasCases;
---

{
  hasAnything && (
    <div class="work-brief not-prose mb-10">
      {summary && <p class="text-sm leading-[1.85] text-muted-foreground">{summary}</p>}

      {hasContributions && (
        <div class="work-brief-scope mt-5">
          <p class="text-sm font-semibold text-foreground mb-1.5">담당 범위</p>
          {/* list-none pl-0 — UA 기본 들여쓰기를 지워 "담당 범위" 라벨과 왼쪽을 맞춘다 */}
          <ul class="work-brief-list flex flex-col gap-1 list-none pl-0 text-sm text-muted-foreground">
            {contributions?.map((item) => (
              <li>{item}</li>
            ))}
          </ul>
        </div>
      )}

      {/* 본문이 곧바로 "문제 1."로 시작하면 맥락 없이 튀어나오는 것처럼 읽힌다.
          아래에서 무엇을 읽게 되는지 한 줄 알려 준다. */}
      {hasCases && (
        <div class="work-brief-cases mt-6 pt-4 border-t border-border/50">
          <p class="text-sm font-semibold text-foreground mb-1.5">문제와 해결</p>
          <p class="text-sm leading-[1.85] text-muted-foreground">
            이 저장소에서 실제로 부딪힌 문제를 케이스로 정리했습니다. 각 케이스는 어떤 상황이었고 무엇이 제약이었는지에서
            시작해, 그래서 어떻게 판단했고 무엇이 남았는지까지 적었습니다.
          </p>
        </div>
      )}
    </div>
  )
}
