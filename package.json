{
  "name": "gitsunmin",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "bun run check:works && bun .scripts/optimize-blog-images.ts && astro check && astro build",
    "check:works": "bun .scripts/check-works-content.ts",
    "check:slides": "bun .scripts/check-slide-length.ts",
    "preview": "astro preview",
    "lint": "eslint . --report-unused-disable-directives --max-warnings 0",
    "format": "biome format --write .",
    "deploy": "gh-pages -d dist --dotfiles",
    "bd": "bun run build && bun run deploy",
    "pull:modules": "git submodule update --remote --merge",
    "gen:book-cover": "bun .scripts/generate-book-cover.ts",
    "test:vi": "vitest",
    "test:ui": "vitest --ui",
    "prepare": "husky"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "^7.3.4",
    "@astrojs/mdx": "^8.1.1",
    "@astrojs/react": "^7.1.1",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.4",
    "@resvg/resvg-js": "^2.6.2",
    "astro": "^7.4.2",
    "clsx": "^2.1.1",
    "lucide-react": "^1.61.0",
    "qrcode": "^1.5.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "satori": "^0.35.2",
    "tailwind-merge": "^3.7.0",
    "ts-pattern": "^5.9.2",
    "vaul": "^1.1.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@biomejs/biome": "^2.6.2",
    "@eslint/compat": "^2.1.1",
    "@eslint/eslintrc": "^3.3.7",
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/mdx": "^2.0.14",
    "@types/node": "^26.6.5",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript-eslint/eslint-plugin": "^8.72.0",
    "@typescript-eslint/parser": "^8.72.0",
    "@vitest/snapshot": "^5.0.5",
    "@vitest/ui": "^5.0.5",
    "caniuse-lite": "^1.0.30001818",
    "esbuild": "^0.28.2",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "gh-pages": "^6.3.0",
    "globals": "^17.13.0",
    "husky": "^9.1.7",
    "jsdom": "^30.1.3",
    "lint-staged": "^17.6.0",
    "pretendard": "^1.3.9",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "vitest": "^5.0.5"
  },
  "lint-staged": {
    "*.{js,mjs,cjs,ts,tsx,mts,cts}": "eslint --report-unused-disable-directives --max-warnings 0 --no-warn-ignored"
  }
}
